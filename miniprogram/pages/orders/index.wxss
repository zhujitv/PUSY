.orders-page { min-height: 100vh; padding-bottom: 60rpx; background: #fff; }
.orders-head { padding: 62rpx 30rpx 44rpx; border-bottom: 1rpx solid #ddd; background: #fff; }
.orders-head > text:last-child { display: block; margin-top: 16rpx; font-size: 68rpx; font-weight: 500; letter-spacing: -4rpx; }
.order-tabs { width: 100%; background: #fff; border-top: 1rpx solid #eee; white-space: nowrap; }
.order-tabs-inner { display: inline-flex; flex-flow: row nowrap; gap: 10rpx; padding: 18rpx 28rpx 22rpx; }
.order-tabs button { min-width: 112rpx; min-height: 62rpx; margin: 0; padding: 0 22rpx; border: 1rpx solid #bbb; border-radius: 0; background: #fff; font-size: 21rpx; }
.order-tabs button.active { border-color: #111; background: #111; color: #fff; }
.order-list { padding: 10rpx 28rpx 24rpx; }
.order-card { margin-bottom: 0; padding: 32rpx 0; border-bottom: 1rpx solid #ccc; background: #fff; }
.order-card > view { display: flex; justify-content: space-between; gap: 20rpx; color: #777; font-size: 21rpx; }
.order-id { display: block; margin: 24rpx 0; word-break: break-all; font-size: 28rpx; font-weight: 600; }
.order-card > view:last-child text:last-child { color: #111; font-size: 28rpx; font-weight: 600; }
.order-progress { display: block; margin-top: 20rpx; padding: 16rpx 18rpx; border-left: 5rpx solid #eb2f83; background: #fff2f7; color: #a52c64; font-size: 21rpx; }
.after-sale-link { min-height: 66rpx; margin-top: 24rpx; padding: 0 20rpx; border: 1rpx solid #bbb; background: #fff; color: #333; font-size: 22rpx; }
