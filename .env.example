# 支付密钥仅配置在服务器环境中。不要提交真实密钥。
DATABASE_URL=

# 独立后台认证。密码至少 8 位；会话密钥至少 32 个随机字符。
ADMIN_EMAIL=admin@pusy.cn
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_PUBLIC_KEY=
WECHAT_PAY_API_V3_KEY=

ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# 消息通知
RESEND_API_KEY=
# 建议使用独立的 Full access 密钥读取收件正文和附件；不要与发信密钥混用。
RESEND_RECEIVING_API_KEY=
RESEND_WEBHOOK_SECRET=
# Resend 收件子域名，例如 reply.pusy.cn。启用后订单邮件可直接回复并进入客服工单。
RESEND_INBOUND_DOMAIN=
INVENTORY_ALERT_EMAIL=
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=PUSY.CN
NOTIFICATION_PROCESS_SECRET=

# 会员验证码使用已启用的邮件或短信通知渠道，不再使用公共测试验证码。

# 中国区经营主体与合规公示信息。正式上线前必须填写。
CHINA_OPERATOR_NAME=
CHINA_UNIFIED_SOCIAL_CREDIT_CODE=
CHINA_REGISTERED_ADDRESS=
CHINA_CUSTOMER_SERVICE_PHONE=
CHINA_SUPPORT_EMAIL=help@PUSY.CN
CHINA_PRIVACY_EMAIL=help@PUSY.CN
CHINA_ICP_NUMBER=
CHINA_PUBLIC_SECURITY_NUMBER=
