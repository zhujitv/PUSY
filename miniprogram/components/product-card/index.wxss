.card { overflow: hidden; border-radius: 12rpx; background: #f2f2f2; }
.image-wrap { position: relative; height: 430rpx; overflow: hidden; background: #f4f3f1; }
.card-feature .image-wrap { height: 520rpx; }
.image { width: 100%; height: 100%; }
.badge { position: absolute; top: 0; left: 0; padding: 10rpx 18rpx; border-radius: 0; background: #eb2f83; color: #fff; font-size: 20rpx; }
.quick-add { position: absolute; left: 14rpx; right: 14rpx; bottom: 14rpx; width: auto; height: 76rpx; padding: 0 14rpx; border-radius: 0; background: rgba(255,255,255,.94); color: #111; font-size: 21rpx; font-weight: 600; }
.quick-add[disabled] { color: #777; background: rgba(255,255,255,.82); }
.copy { display: flex; flex-direction: column; min-height: 168rpx; padding: 22rpx 20rpx 26rpx; }
.category { margin-bottom: 8rpx; color: #8a8a8a; font-size: 20rpx; }
.name { min-height: 68rpx; font-size: 27rpx; font-weight: 500; line-height: 1.3; }
.price { margin-top: 10rpx; font-size: 25rpx; font-weight: 600; }
