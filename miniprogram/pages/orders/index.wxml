<view class="page-shell orders-page">
  <view class="orders-head"><text class="eyebrow">MY ORDERS</text><text>我的订单</text></view>
  <scroll-view class="order-tabs" scroll-x enhanced show-scrollbar="{{false}}"><view class="order-tabs-inner"><button wx:for="{{tabs}}" wx:key="key" class="{{activeTab === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="selectTab">{{item.label}}</button></view></scroll-view>
  <view wx:if="{{orders.length}}" class="order-list"><view wx:for="{{orders}}" wx:key="id" class="order-card" data-id="{{item.id}}" bindtap="openOrder"><view><text>{{item.preview && item.status === '开发预览' ? '开发预览' : item.status}}</text><text>{{item.createdAt}}</text></view><text class="order-id">{{item.id}}</text><view><text>{{item.shipment ? item.shipment.carrier_name + ' · ' + item.shipment.status : (item.delivery || '配送方式待确认')}}</text><text>{{item.totalText}}</text></view><text wx:if="{{item.refunds.length}}" class="order-progress">退款进度：{{item.refunds[0].statusText}}</text><text wx:elif="{{item.returns.length}}" class="order-progress">售后进度：{{item.returns[0].status}}</text><button wx:if="{{item.canAfterSale}}" class="after-sale-link" data-id="{{item.id}}" catchtap="openAfterSale">申请售后</button></view></view>
  <view wx:elif="{{!loading}}" class="empty-state"><text class="empty-title">{{activeTab === 'all' ? '还没有订单' : '这个分类暂无订单'}}</text><text class="empty-copy">{{activeTab === 'all' ? '从商品目录挑选喜欢的商品，完成第一笔预览订单。' : '可以切换其他状态继续查看。'}}</text><button wx:if="{{activeTab === 'all'}}" class="primary-button" bindtap="browse">去逛逛</button></view>
</view>
