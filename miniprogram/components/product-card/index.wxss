.card { overflow: hidden; background: #fff; }
.image-wrap { position: relative; height: 430rpx; overflow: hidden; background: #f4f3f1; }
.image { width: 100%; height: 100%; }
.badge { position: absolute; top: 16rpx; left: 16rpx; padding: 8rpx 14rpx; border-radius: 999rpx; background: rgba(255,255,255,.9); font-size: 19rpx; }
.quick-add { position: absolute; right: 16rpx; bottom: 16rpx; width: 66rpx; height: 66rpx; display: flex; align-items: center; justify-content: center; padding: 0; border-radius: 50%; background: #111; color: #fff; font-size: 38rpx; font-weight: 300; }
.copy { display: flex; flex-direction: column; min-height: 164rpx; padding: 18rpx 2rpx 26rpx; }
.category { margin-bottom: 8rpx; color: #8a8a8a; font-size: 20rpx; }
.name { min-height: 68rpx; font-size: 26rpx; line-height: 1.3; }
.price { margin-top: 10rpx; font-size: 25rpx; font-weight: 600; }
