.detail-page { min-height: 100vh; padding-bottom: 60rpx; background: #fff; }
.detail-head { padding: 58rpx 30rpx 44rpx; border-bottom: 1rpx solid #ccc; background: #fff; }
.detail-head > text { display: block; }
.detail-status { margin-top: 18rpx; color: #111; font-size: 60rpx; font-weight: 500; letter-spacing: -3rpx; }
.detail-id { margin: 18rpx 0 8rpx; word-break: break-all; font-size: 22rpx; font-weight: 600; }
.detail-head > text:last-child { color: #888; font-size: 21rpx; }
.payment-countdown { display: grid; grid-template-columns: 1fr auto; gap: 10rpx 20rpx; margin-top: 26rpx; padding: 24rpx; border: 1rpx solid #eb2f83; background: #fff; color: #8c2858; }
.payment-countdown > text:nth-child(2) { font-size: 32rpx; font-weight: 700; }
.payment-countdown > text:last-child { grid-column: 1 / -1; font-size: 20rpx; }
.detail-card { margin: 0 30rpx; padding: 36rpx 0; border-bottom: 1rpx solid #ccc; background: #fff; }
.card-title, .info-row, .shipment-summary, .return-row { display: flex; justify-content: space-between; gap: 24rpx; }
.card-title, .card-heading { font-weight: 600; }
.card-title > text:last-child { color: #888; font-size: 21rpx; }
.item-row { display: grid; grid-template-columns: 96rpx 1fr auto; gap: 18rpx; align-items: center; padding: 22rpx 0; border-bottom: 1rpx solid #eee; }
.item-row image { width: 96rpx; height: 112rpx; background: #eee; }
.item-row view text { display: block; }
.item-row view text:last-child { margin-top: 8rpx; color: #888; font-size: 21rpx; }
.info-row { margin-top: 22rpx; color: #666; line-height: 1.5; }
.info-row > text:last-child { max-width: 68%; color: #111; text-align: right; }
.total-row { padding-top: 22rpx; border-top: 1rpx solid #eee; font-size: 30rpx; font-weight: 600; }
.shipment-summary { align-items: center; margin-top: 24rpx; padding: 24rpx; border: 1rpx solid #ddd; background: #fff; }
.shipment-summary text { display: block; }
.shipment-summary text:last-child { margin-top: 8rpx; color: #777; font-size: 21rpx; }
.shipment-summary button { min-height: 58rpx; margin: 0; padding: 0 18rpx; border: 1rpx solid #aaa; background: #fff; font-size: 20rpx; }
.refresh-button { min-height: 54rpx; margin: 0; padding: 0 18rpx; border: 1rpx solid #bbb; background: #fff; font-size: 20rpx; }
.timeline { margin-top: 28rpx; }
.timeline-row { display: grid; grid-template-columns: 20rpx 1fr; gap: 18rpx; padding-bottom: 26rpx; }
.timeline-dot { width: 14rpx; height: 14rpx; margin-top: 8rpx; border-radius: 50%; background: #eb2f83; box-shadow: 0 0 0 7rpx #ffe3f0; }
.timeline-row text { display: block; line-height: 1.5; }
.timeline-row text:last-child { margin-top: 7rpx; color: #888; font-size: 20rpx; }
.empty-copy { display: block; margin-top: 22rpx; color: #888; font-size: 22rpx; line-height: 1.6; }
.return-row { margin-top: 20rpx; }
.return-row > text:last-child { color: #777; }
.refund-row { display: flex; justify-content: space-between; gap: 20rpx; margin-top: 22rpx; padding-top: 20rpx; border-top: 1rpx solid #eee; }
.refund-row view text { display: block; }
.refund-row view text:last-child { margin-top: 6rpx; color: #888; font-size: 20rpx; }
.refund-row > text { color: #c62f72; font-weight: 600; }
.cancel-note { margin: 20rpx 30rpx 0; padding: 22rpx; background: #f2f1ef; color: #666; font-size: 21rpx; line-height: 1.5; }
.after-sale-button { margin: 24rpx 30rpx 0; }
.cancel-button { margin: 18rpx 30rpx 0; border-color: #c62f72; color: #a52c64; }
