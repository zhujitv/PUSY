.shipping { height: 70rpx; display: flex; align-items: center; justify-content: center; background: #eb2f83; color: #fff; font-size: 22rpx; font-weight: 600; letter-spacing: 1rpx; }
.home-head { min-height: 116rpx; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 28rpx; border-bottom: 1rpx solid #ededed; }
.home-market { font-size: 21rpx; }
.home-head .brand-word { font-size: 68rpx; }
.preview-pill { justify-self: end; padding: 7rpx 0; color: #eb2f83; font-size: 20rpx; font-weight: 600; }
.hero { height: 780rpx; margin: 0; }
.hero-slide { position: relative; height: 100%; overflow: hidden; background: #c5e8f7; }
.hero-image { width: 100%; height: 100%; }
.hero-overlay { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(12,22,34,.52), rgba(12,22,34,.05) 72%); }
.hero-copy { position: absolute; left: 42rpx; right: 40rpx; bottom: 58rpx; display: flex; flex-direction: column; color: #fff; }
.hero-kicker { margin-bottom: 18rpx; font-size: 22rpx; font-weight: 600; letter-spacing: 3rpx; }
.hero-title { white-space: pre-line; font-size: 65rpx; line-height: .98; font-weight: 500; letter-spacing: -4rpx; }
.hero-action { align-self: flex-start; margin-top: 34rpx; padding: 18rpx 28rpx; border: 1rpx solid rgba(255,255,255,.9); font-size: 22rpx; font-weight: 600; }
.category-strip { width: 100%; margin-top: 24rpx; white-space: nowrap; }
.category-strip-inner { display: inline-flex; gap: 14rpx; padding: 10rpx 28rpx 18rpx; }
.category-pill { min-height: 66rpx; padding: 0 28rpx; border: 1rpx solid #cfcfcf; border-radius: 999rpx; background: #fff; color: #222; font-size: 22rpx; }
.product-scroll { width: calc(100% + 36rpx); margin-left: -18rpx; white-space: nowrap; }
.product-grid { display: inline-flex; gap: 14rpx; padding: 0 18rpx; }
.product-cell { width: 540rpx; flex: 0 0 540rpx; white-space: normal; }
.editorial { margin: 86rpx 0 0; overflow: hidden; border-radius: 14rpx; background: #f7a5ca; }
.editorial-image { width: 100%; height: 700rpx; display: block; }
.editorial-copy { padding: 44rpx 38rpx 48rpx; }
.editorial-title { display: block; margin: 18rpx 0 24rpx; white-space: pre-line; font-size: 52rpx; line-height: 1; letter-spacing: -3rpx; }
.editorial-text { display: block; max-width: 560rpx; color: #503843; line-height: 1.7; }
.editorial-button { width: 100%; margin-top: 36rpx; min-height: 88rpx; border: 1rpx solid #111; background: transparent; font-size: 23rpx; font-weight: 600; }
.service-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rpx; margin-top: 80rpx; background: #d8d5d2; }
.service-row > view { min-height: 220rpx; display: flex; flex-direction: column; padding: 28rpx 20rpx; background: #fff; }
.service-no { color: var(--pink); font-size: 20rpx; }
.service-title { margin-top: auto; font-size: 26rpx; font-weight: 600; }
.service-copy { margin-top: 8rpx; color: #777; font-size: 19rpx; line-height: 1.4; }
.page-shell { padding-bottom: calc(112rpx + env(safe-area-inset-bottom)); }
